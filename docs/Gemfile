source "https://rubygems.org"

# GitHub Pages gem keeps Jekyll + plugins pinned to whatever GitHub Pages
# itself runs in production. Use `bundle exec jekyll serve` from this
# directory to preview the docs site locally.
gem "github-pages", group: :jekyll_plugins

# Required by just-the-docs (remote theme) and our custom plugin set.
group :jekyll_plugins do
  gem "jekyll-remote-theme"
  gem "jekyll-seo-tag"
  gem "jekyll-relative-links"
  gem "jekyll-default-layout"
  gem "jekyll-titles-from-headings"
end

# Windows + JRuby dependency shims; harmless on macOS / Linux.
platforms :mingw, :x64_mingw, :mswin, :jruby do
  gem "tzinfo", ">= 1", "< 3"
  gem "tzinfo-data"
end

gem "wdm", "~> 0.1.1", platforms: [:mingw, :x64_mingw, :mswin]
