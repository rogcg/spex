{
  "name": "@spex/mcp-server",
  "version": "1.0.0",
  "private": true,
  "description": "MCP server exposing SPEX as tools to MCP-compatible IDEs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rogcg/spex.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://github.com/rogcg/spex#readme",
  "bugs": {
    "url": "https://github.com/rogcg/spex/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "spex-mcp-server": "./dist/bin.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@spex/core": "workspace:*",
    "@spex/integrations-github": "workspace:^",
    "@spex/schemas": "workspace:*",
    "@spex/skills": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "execa": "^9.5.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "yaml": "^2.6.1"
  }
}
